{
  "config": {
    "default": true,
    // Long lines are fine in tables and prose.
    "MD013": false,
    // Documents may repeat a heading under different parents ("Limits", "Results").
    "MD024": { "siblings_only": true },
    // The PR template intentionally starts with a second-level heading.
    "MD041": false,
    // Bold run-in labels are used as light sub-headings.
    "MD036": false,
    // Table pipe spacing is cosmetic.
    "MD060": false,
    // Numbered lists may continue across sub-headings.
    "MD029": false
  },
  "ignores": ["**/node_modules/**", "**/target/**", "**/.venv/**"]
}
