# Servora local environment template.
# Copy to .env and replace every placeholder. Never commit .env.
# Docker Compose and the core API (run from services/core-api) both read this file.
# Only variables used by the current milestone are listed; later milestones add theirs.

# --- PostgreSQL (pgvector) ---
SERVORA_POSTGRES_HOST=localhost
# Host port, bound to 127.0.0.1 only.
SERVORA_POSTGRES_PORT=5432
SERVORA_POSTGRES_DB=servora
# Owner role: runs Flyway migrations and owns the tables. Not used to serve requests.
SERVORA_POSTGRES_OWNER_USER=servora_owner
SERVORA_POSTGRES_OWNER_PASSWORD=replace-with-a-local-password
# Runtime role: the core API serves requests with it. It owns nothing and cannot bypass
# Row-Level Security. Created when the database volume is first initialised.
SERVORA_POSTGRES_APP_USER=servora_app
SERVORA_POSTGRES_APP_PASSWORD=replace-with-a-different-local-password

# Worker role: the document worker uses it. Knowledge tables only, also under Row-Level Security.
SERVORA_POSTGRES_WORKER_USER=servora_worker
SERVORA_POSTGRES_WORKER_PASSWORD=replace-with-a-third-local-password

# --- Redis ---
SERVORA_REDIS_PORT=6379

# --- Core API ---
SERVORA_API_PORT=8080
# Base64-encoded HMAC key for access tokens, at least 32 bytes. Generate: openssl rand -base64 48
SERVORA_JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Keep true. Browsers accept Secure cookies on http://localhost.
SERVORA_REFRESH_COOKIE_SECURE=true
# Where the dashboard is served; used to build links in emails.
SERVORA_WEB_BASE_URL=http://localhost:5173
# LOCAL DEVELOPMENT ONLY: no email provider exists yet, so verification and invitation links are
# written to the core API log. These links contain secret tokens. Never enable this anywhere else.
SERVORA_MAIL_LOG_LINKS=true

# --- Private document storage (S3-compatible; a local emulator in development) ---
SERVORA_STORAGE_ENDPOINT=http://localhost:7070
SERVORA_STORAGE_REGION=us-east-1
SERVORA_STORAGE_BUCKET=servora-documents
SERVORA_STORAGE_ACCESS_KEY=replace-with-a-local-access-key
SERVORA_STORAGE_SECRET_KEY=replace-with-a-local-secret-key

# --- Document worker ---
# Where the core API (on the host) reaches the worker's internal enqueue endpoint.
SERVORA_WORKER_ENQUEUE_URL=http://localhost:8090/internal/v1/ingestion-jobs
# Base64-encoded HMAC key shared by the core API and the worker, at least 32 bytes. Must differ
# from SERVORA_JWT_SECRET. Generate: openssl rand -base64 48
SERVORA_INTERNAL_TOKEN_SECRET=replace-with-another-output-of-openssl-rand-base64-48
