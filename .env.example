# Servora local environment template.
# Copy to .env and replace every placeholder. Never commit .env.
# Only variables used by the current milestone are listed; later milestones add theirs.

# --- PostgreSQL (pgvector) ---
SERVORA_POSTGRES_DB=servora
# Owner role: runs migrations and owns tables. The application runtime role is created in M1.
SERVORA_POSTGRES_OWNER_USER=servora_owner
SERVORA_POSTGRES_OWNER_PASSWORD=replace-with-a-local-password
# Host port, bound to 127.0.0.1 only.
SERVORA_POSTGRES_PORT=5432

# --- Redis ---
SERVORA_REDIS_PORT=6379
